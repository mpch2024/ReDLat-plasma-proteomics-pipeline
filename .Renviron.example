# Local paths and analysis settings. Copy this file to .Renviron.
# Never commit the populated .Renviron file.

REDLAT_PROJECT_ROOT=

# DEP
REDLAT_DEP_DATA_DIR=
REDLAT_DEP_METADATA_FILE=
REDLAT_DEP_ADAT_FILE=
REDLAT_DEP_RESULT_ROOT=
REDLAT_DEP_PUBLICATION_ROOT=

# WGCNA
REDLAT_WGCNA_RESULT_ROOT=
REDLAT_WGCNA_PUBLICATION_ROOT=

# Machine learning
REDLAT_ML_DATA_DIR=
REDLAT_ML_METADATA_FILE=
REDLAT_ML_ADAT_FILE=
REDLAT_ML_MASTER_FILE=
REDLAT_ML_NO_EXCLUSIONS_FILE=
REDLAT_ML_EXCLUDED_IDS_FILE=
REDLAT_ML_RESULT_ROOT=
REDLAT_ML_PUBLICATION_ROOT=
REDLAT_ML_PTAU_METADATA_FILE=
REDLAT_ML_MATCHED_IDS_FILE=
REDLAT_ML_MATCHED_FULL_FILE=
REDLAT_ML_MATCHING_FOCUS_ID=

# Export governance
REDLAT_ALLOW_PARTICIPANT_LEVEL_EXPORTS=false

# Strict nested-CV settings
REDLAT_ML_RANDOM_STATE=42
REDLAT_ML_INNER_FOLDS=5
REDLAT_ML_INNER_STABILITY=1.0
REDLAT_ML_COEFFICIENT_THRESHOLD=0.005
REDLAT_ML_FALLBACK_TOP_N=10
REDLAT_ML_MAX_MISSING_FRACTION=0.20
REDLAT_ML_MIN_VARIANCE=1e-12
REDLAT_ML_SELECTOR_SEARCH_ITER=30
REDLAT_ML_SVM_SEARCH_ITER=50
REDLAT_ML_PERMUTATION_REPEATS=50
REDLAT_ML_N_JOBS=-1
REDLAT_ML_ALLOW_NONCANONICAL_MATCH_COUNTS=false
